---
import data from 'blume:data';
import PageLayout from 'blume/components/layout/PageLayout.astro';

const config = data.config;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: config.title, description: config.description }}
>
  <section class="hero">
    <div class="badge"><span class="dot"></span>open source · jaeger v2</div>
    <h1>
      a dark instrument panel<br />
      <span>for distributed traces</span>
    </h1>
    <p>
      point it at an existing jaeger v2 and get a home overview, trace
      exploration, error aggregation, and per-service filtering — built on a
      publishable react sdk.
    </p>
    <div class="actions">
      <a class="primary" href="/docs/app/quickstart">get started</a>
      <a class="secondary" href="/docs/sdk/getting-started">sdk docs</a>
    </div>
  </section>

  <section class="features">
    <div>
      <small>app</small>
      <h3>dashboard first</h3>
      <p>
        home overview, trace list, error aggregation. density is the feature —
        maximum signal per screen.
      </p>
    </div>
    <div>
      <small>sdk</small>
      <h3>@traces/react</h3>
      <p>
        publishable component sdk — waterfall, trace detail, issue list, and
        more. bring your own router.
      </p>
    </div>
    <div>
      <small>design</small>
      <h3>token-driven theming</h3>
      <p>
        css variable tokens for surfaces, borders, text, accent, and status.
        override any token to match your brand.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--blume-border);
    border-radius: 4px;
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #3dd68c;
  }
  h1 {
    margin-top: 1.5rem;
    max-width: 42rem;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  h1 span,
  .hero p {
    color: var(--blume-muted-foreground);
  }
  .hero p {
    margin-top: 1rem;
    max-width: 32rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .actions a {
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }
  .primary {
    background: var(--blume-accent);
    color: #0b0d10;
  }
  .secondary {
    border: 1px solid var(--blume-border);
    color: var(--blume-foreground);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: 1px solid var(--blume-border);
  }
  .features > div {
    padding: 2.5rem 2rem;
    border-bottom: 1px solid var(--blume-border);
  }
  small {
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .features p {
    margin-top: 0.5rem;
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    line-height: 1.6;
  }
</style>
