{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".source/**"]
    },
    "check:tsc": {
      "dependsOn": ["^build"]
    },
    "check:lint": {},
    "check": { "dependsOn": ["check:tsc", "check:lint"] }
  }
}
